{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acemode.example/schemas/context-catalog.schema.json",
  "title": "AceMode Context Catalog",
  "type": "object",
  "required": ["schemaVersion", "records"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "path", "owner", "status", "source", "verifiedAt", "reviewAfter", "sensitivity"],
        "properties": {
          "id": { "type": "string", "minLength": 3 },
          "path": { "type": "string", "pattern": "^context/" },
          "owner": { "type": "string", "minLength": 2 },
          "status": { "enum": ["draft", "active", "stale", "archived"] },
          "source": { "type": "string", "minLength": 2 },
          "verifiedAt": { "type": "string", "format": "date" },
          "reviewAfter": { "type": "string", "format": "date" },
          "sensitivity": { "enum": ["public", "internal", "restricted"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
