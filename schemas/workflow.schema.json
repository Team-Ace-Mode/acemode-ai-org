{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acemode.example/schemas/workflow.schema.json",
  "title": "AceMode Workflow Contract",
  "type": "object",
  "required": ["schemaVersion", "id", "version", "status", "owner", "triggers", "inputs", "steps", "outputs", "failurePolicy"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string" },
    "version": { "type": "string" },
    "status": { "enum": ["draft", "pilot", "active", "deprecated"] },
    "owner": { "type": "string" },
    "triggers": { "type": "array" },
    "inputs": { "type": "array" },
    "steps": { "type": "array", "minItems": 1 },
    "outputs": { "type": "array" },
    "failurePolicy": { "type": "object" }
  },
  "additionalProperties": false
}
